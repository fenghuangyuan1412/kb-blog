# 复制成 .env 后填真实值；.env 已被 gitignore，禁止提交
# —— 数据库 ——
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=kb
PGUSER=kb
PGPASSWORD=change-me-local-only
DATABASE_URL=postgres://kb:change-me-local-only@127.0.0.1:5433/kb?sslmode=disable
PGDATA=E:\pgsql_data

# —— 服务 ——
ADDR=:8080
BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173

# —— 认证（仅管理员单用户）——
JWT_SECRET=至少32位随机字符串
ADMIN_EMAIL=admin@example.com
# 只存 bcrypt 哈希，不存明文：powershell -File scripts\hashpw.ps1 你的密码
ADMIN_PASSWORD_HASH=
COOKIE_NAME=kb_token
COOKIE_SECURE=false

# —— 前端 ——
VITE_API_BASE=http://localhost:8080
